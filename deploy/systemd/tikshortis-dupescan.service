[Unit]
Description=Scan the Tikshortis library for duplicate clips
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Substitute the account that may talk to the docker socket on this host.
# Left as-is the unit refuses to start, which is the intended failure.
User=CHANGEME
Group=CHANGEME
# Groups byte-identical and perceptually identical clips into short_dupe_groups
# for review under Settings -> Duplicates. Deletes nothing. The per-clip
# fingerprint cache (carried over in the migration) makes every run after the
# first cheap. Pairs dismissed in the UI are skipped.
# Ceiling for one run. Note that systemd kills the `docker exec` client, not
# the process inside the container: the per-command timeouts in the script are
# what actually stops a hung ffmpeg or yt-dlp, and the script's own lockfile
# prevents the next run from overlapping. This ceiling is the visible failure
# (`systemctl --failed`) when something still ran away.
TimeoutStartSec=6h
ExecStart=/usr/bin/docker exec tikshortis node scripts/scan-shorts-duplicates.mjs
Nice=18
IOSchedulingClass=idle
