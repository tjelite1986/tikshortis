# Everything the image builds itself or must never contain. COPY . . does not
# honour .gitignore, so this list is what keeps a host checkout's node_modules
# (wrong arch), .next (wrong build) and data/ (a live database) out of the
# build context.
.git
.github
node_modules
.next
data
docs
deploy
*.log
.env
.env.*
tsconfig.tsbuildinfo
README.md
Dockerfile
.dockerignore
